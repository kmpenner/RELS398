# =====================================================================
#  RELS 398 (Digital Methods) .gitignore
#  Developer Conventions: raw/ | src/ | dist/ | config/ | scripts/ | private/
#  Rule of thumb: git tracks what you AUTHOR (prose, code, XML, docx).
#  Large binary assets, downloads, compiler cruft, and PII are excluded.
# =====================================================================

# ---- Privacy, Legal & Student PII (Strictly local / machine rsync) ----
private/
*Grades*
*grades*
*assignsubmission*
*.csv

# ---- Raw Downloaded Source Materials (Scans, Workbooks, Audio) -------
raw/textbooks/
raw/audio_transcripts/
raw/media/
raw/readings/
NotebookLM_Assets/

# ---- Bulk Media, Scratch, and Temporary Snapshots -------------------
media/
archive/
scratch/
backups/
_work/
*.mp4
*.mov
*.avi
*.mkv
*.m4a
*.mp3
*.wav
*.aac

# ---- Heavy Binaries git handles poorly ------------------------------
*.pptx
*.odp
*.zip
*.bak

# ---- Secrets, Machine & IDE Settings --------------------------------
.claude/settings.local.json
.env
*.key

# ---- Python / OS Artifacts ------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.DS_Store
*.log
*~
.~lock.*#
.media-attic/

# ---- LaTeX Intermediate Compiler Cruft ------------------------------
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz


# Build staging: half-lesson markdown written by the image generator.
# Ephemeral per LEDGER.md section 1.6 — never authoritative, never committed.
.staging_*/

# Nested live demo git repo (scratch projection copy)
labs/

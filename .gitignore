# =====================================================================
#  RELS 398 (Digital Methods) .gitignore
#  Rule of thumb: git tracks things you AUTHOR (prose, code, XML, docx).
#  Everything large, downloaded, generated, or confidential is excluded
#  and synced by rsync instead (see shared/GIT_SYNC.md).
# =====================================================================

# ---- Student data & PII: never leaves this machine ------------------
private/
Research Project/*.zip
Research Project/Grades-*.csv

# ---- Downloaded source materials (scans, books, articles) -----------
*/sources/
*/Source_PDFs/
*/01_Source_Materials/
*/books/
*/Books/
NotebookLM_Assets/

# ---- Bulk media, scratch, and old snapshots -------------------------
media/
archive/
scratch/
backups/
_work/
*/images/
*.mp4
*.mov
*.avi
*.mkv
*.m4a
*.mp3
*.wav
*.aac

# ---- Heavy binaries git handles badly -------------------------------
*.pptx
*.odp
*.zip
*.bak

# ---- Machine-local agent settings ------------------------------------
.claude/settings.local.json

# ---- Python / editor / OS artifacts ---------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.DS_Store
*.log
.env
*~
.~lock.*#
.media-attic/

# ---- Superseded placeholders (see the README.md in each folder) ------
.gitkeep

# ---- Drive-only imports (Ken's decision, see 00_.../OneDrive_import_plan.md) --
# Downloaded material, not authored here. The generic */sources/ pattern
# doesn't reach this depth, so name it explicitly.
03_Research/Griffitts_Thesis_and_Software/
